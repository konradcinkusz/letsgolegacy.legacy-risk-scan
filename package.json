{
  "name": "legacy-risk-scan",
  "version": "0.1.0",
  "private": true,
  "description": "Legacy Risk Scan \u2014 a static page that reads a .csproj, packages.config, composer.json/lock or package.json in the browser and reports end-of-life and known vulnerabilities.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs --base /letsgolegacy.legacy-risk-scan/",
    "e2e": "node scripts/build.mjs && playwright test --project=chromium",
    "e2e:live": "playwright test --project=live",
    "update-eol": "node scripts/update-eol.mjs",
    "smoke:osv": "node scripts/smoke-osv.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0"
  }
}
